# Plantilla de secretos. COPIA este archivo a `secrets.toml` y complet├í los
# valores. `secrets.toml` esta en .gitignore y NUNCA se sube al repositorio.
#
# En Streamlit Community Cloud no se sube ningun archivo: estos mismos valores
# se pegan en Settings -> Secrets de la app.

# Clave para entrar. Si esta vacia o no existe, la app no pide nada, que es lo
# que queres cuando corre en tu laptop.
clave_acceso = "poné-una-clave-larga-acá"

# La SEC exige un email real en el User-Agent; sin eso devuelve 403.
# Va en los secretos, no en el codigo: este archivo es una plantilla y el
# repositorio es publico, asi que aca no se escribe el email de verdad.
email_sec = "tu-email@ejemplo.com"

# Almacen externo para el universo de tickers y tus tesis. Sin esto, en la nube
# se pierden en cada reinicio.
#
# Como obtenerlos:
#   1. Crea un Gist PRIVADO en https://gist.github.com con un archivo
#      `universo.json` que contenga:  []
#   2. El gist_id es lo ultimo de la URL.
#   3. El token: https://github.com/settings/tokens -> Fine-grained token,
#      con permiso "Gists: Read and write" y nada mas.
github_token = "github_pat_..."
gist_id = "abc123..."
